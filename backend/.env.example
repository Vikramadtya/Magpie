# Database Configuration
DB_URL=jdbc:postgresql://localhost:5433/keeper
DB_USER=postgres
DB_PASSWORD=password
FLYWAY_ENABLED=true

# Authentication (JWT & OAuth)
JWT_SECRET=your_super_secret_jwt_key_here_must_be_very_long_for_hs256
OAUTH_GOOGLE_CLIENT_ID=your_google_client_id_here
OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# App Settings
MICRONAUT_ENVIRONMENTS=dev
MICRONAUT_SERVER_PORT=8080

# Frontend Integration
FRONTEND_URL=https://keeper.yourdomain.com
