# API Configuration
VITE_API_URL=http://localhost:8080

# Feature Flags
# Set to 'true' to use the local mock data generator instead of connecting to a backend
VITE_USE_MOCK_API=true

# Error Tracking (Optional)
VITE_SENTRY_DSN=

# Logging Configuration
# Levels: trace, debug, info, warn, error, silent
VITE_LOG_LEVEL=debug
# Categories to log (comma separated). Use '*' for all, or specific categories like 'api,auth'
VITE_DEBUG=*
